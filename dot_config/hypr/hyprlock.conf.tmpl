# TODO: This is device specific
background {
  monitor=HDMI-A-1
  blur_passes=0
  color=rgb({{ .theme.palette.base00 }})
  # path=$HOME/bg2560.png
}

background {
  monitor=DVI-D-1
  blur_passes=0
  color=rgb({{ .theme.palette.base00 }})
  # path=$HOME/bg1920.png
}

general {
  grace=15
  hide_cursor=true
}

image {
  monitor=
  size=100
  border_color=rgb({{ .theme.palette.base07 }})
  halign=center
  # path=$HOME/.face
  position=0, 75
  valign=center
}

input-field {
  monitor=
  size=300, 60
  capslock_color=rgb({{ .theme.palette.base0A }})
  check_color=rgb({{ .theme.palette.base07 }})
  dots_center=true
  dots_size=0.200000
  dots_spacing=0.200000
  fade_on_empty=false
  fail_color=rgb({{ .theme.palette.base08 }})
  fail_text=<i>$FAIL <b>($ATTEMPTS)</b></i>
  font_color=rgb({{ .theme.palette.base05 }})
  halign=center
  hide_input=false
  inner_color=rgb({{ .theme.palette.base02 }})
  outer_color=rgb({{ .theme.palette.base07 }})
  outline_thickness=4
  placeholder_text=<span foreground='##{{ .theme.palette.base05 }}'><i>󰌾 Logged in as </i><span foreground='##{{ .theme.palette.base07 }}'>$USER</span></span>
  position=0, -47
  valign=center
}

label {
  monitor=
  color=rgb({{ .theme.palette.base05 }})
  font_family={{ .theme.fonts.monospace }}
  font_size=25
  halign=left
  position=30, -30
  text=Layout: $LAYOUT
  valign=top
}

label {
  monitor=
  color=rgb({{ .theme.palette.base05 }})
  font_family={{ .theme.fonts.monospace }}
  font_size=90
  halign=right
  position=-30, 0
  text=$TIME
  valign=top
}

label {
  monitor=
  color=rgb({{ .theme.palette.base05 }})
  font_family={{ .theme.fonts.monospace }}
  font_size=25
  halign=right
  position=-30, -150
  text=cmd[update:43200000] date +'%A, %d %B %Y'
  valign=top
}

# vim:ft=hyprlang
